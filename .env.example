# =============================================================================
# Frontier Marketplace - environment configuration
# Copy to .env and fill in real values:   cp .env.example .env
# Never commit .env - it holds passwords.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public address of the site. Used for the "Open in admin dashboard" link in
# inquiry emails.
APP_URL=https://marketplace.frontierfc.co.zm
# Long random string (32+ characters) that signs admin session cookies.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Number of reverse proxies in front of the app (Nginx = 1).
TRUST_PROXY=1
# Time zone used for dates in inquiry emails.
APP_TIMEZONE=Africa/Lusaka

# --- MySQL -------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=frontier_user
DB_PASSWORD=your-database-password
DB_NAME=frontier_marketplace

# --- Email (inquiry notifications) -------------------------------------------
# Every inquiry is emailed to INQUIRY_NOTIFY_EMAILS (comma-separated).
#
# Gmail example: turn on 2-Step Verification for the sending account, then
# create an App Password (Google Account > Security > App passwords) and put
# that 16-character app password in SMTP_PASS - not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sending-account@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="Frontier Marketplace <sending-account@gmail.com>"
INQUIRY_NOTIFY_EMAILS=mpimpa.miyoba@gmail.com,dalisomwale003@gmail.com

# --- Optional ----------------------------------------------------------------
# Only needed if the API is called from a different origin.
# CORS_ORIGIN=https://marketplace.frontierfc.co.zm
