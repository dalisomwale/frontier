# =============================================================================
# Frontier Marketplace - environment configuration
# Copy to .env and fill in real values:   cp .env.example .env
# Never commit .env - it holds passwords.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public address of the site. Used for the "Open in admin dashboard" link in
# inquiry emails.
APP_URL=https://marketplace.frontierfc.co.zm
# Long random string (32+ characters) that signs admin session cookies.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Number of reverse proxies in front of the app (Nginx = 1).
TRUST_PROXY=1
# Time zone used for dates in inquiry emails.
APP_TIMEZONE=Africa/Lusaka

# --- MySQL -------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=frontier_user
DB_PASSWORD=your-database-password
DB_NAME=frontier_marketplace

# --- Email (inquiry notifications) -------------------------------------------
# Every inquiry is emailed to INQUIRY_NOTIFY_EMAILS (comma-separated).
#
# Gmail example: turn on 2-Step Verification for the sending account, then
# create an App Password (Google Account > Security > App passwords) and put
# that 16-character app password in SMTP_PASS - not your normal password.
# (Spaces in the App Password are fine; they're ignored.) After editing,
# restart the app and run `npm run test-email` to check.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sending-account@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="Frontier Marketplace <sending-account@gmail.com>"
INQUIRY_NOTIFY_EMAILS=mpimpa.miyoba@gmail.com,dalisomwale003@gmail.com

# --- What customers and sellers see in emails --------------------------------
# Phone / WhatsApp shown at the bottom of every customer and seller email.
SUPPORT_PHONE=
# Where replies to those emails go (a mailbox your team reads, e.g. info@...).
# If empty, replies go to the MAIL_FROM address.
REPLY_TO_EMAIL=
# Morning summary to INQUIRY_NOTIFY_EMAILS (only when something needs
# attention). Time is in APP_TIMEZONE. Set DAILY_SUMMARY=off to stop it.
DAILY_SUMMARY=on
DAILY_SUMMARY_TIME=07:30

# --- Mobile money payments on the website (Lenco) ---------------------------
# Leave LENCO_SECRET_KEY empty to keep the current checkout (the team arranges
# payment). With a key, buyers paying by Airtel Money, MTN MoMo or Zamtel
# Kwacha get a prompt on their phone to enter their PIN, and the order is
# marked paid when they approve it.
# Keys: Lenco dashboard (https://lenco.co) > API. Use the sandbox key with
# LENCO_ENV=sandbox to test, then the live key with LENCO_ENV=production.
# Webhook URL to set in the Lenco dashboard:
#   https://marketplace.frontierfc.co.zm/api/payments/lenco/webhook
LENCO_SECRET_KEY=
LENCO_ENV=sandbox
# Who pays Lenco's fee: merchant (default) or customer.
# LENCO_FEE_BEARER=merchant

# --- Optional ----------------------------------------------------------------
# Only needed if the API is called from a different origin.
# CORS_ORIGIN=https://marketplace.frontierfc.co.zm

# --- Lipila (mobile money: Airtel, MTN, Zamtel) ----------------------------
# When set, the PIN prompt for cart checkouts goes through Lipila (it takes
# over from Lenco). Key from the Lipila dashboard. Payments are LIVE (real
# money) unless LIPILA_ENV=sandbox. Never commit the real key.
# LIPILA_API_KEY=
# LIPILA_ENV=sandbox
# Visa / Mastercard through Lipila's card page. Turn on only after Lipila has
# enabled card payments for the merchant account:
# LIPILA_CARDS=on
# Buyers go to Lipila's secure card page and come back. LIPILA_CARD_EMBED=on
# shows it inside the checkout instead, if the card site allows that.
# LIPILA_CARD_EMBED=on

# Optional override of the API address:
# LIPILA_BASE_URL=https://blz.lipila.io/api/v1
