{
  "name": "frontier-marketplace",
  "version": "2.0.0",
  "description": "Frontier Marketplace - admin-managed livestock discovery and inquiry platform for Frontier Farms & Consult Ltd",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "db:setup": "node database/setup.js",
    "create-admin": "node scripts/create-admin.js",
    "test-email": "node scripts/test-email.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/tailwind.css --minify"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "livestock",
    "cattle",
    "inquiry",
    "marketplace",
    "zambia"
  ],
  "author": "Frontier Farms & Consult Ltd",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.13",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
